{
  "name": "manga-video",
  "private": true,
  "type": "module",
  "scripts": {
    "build:explainer": "node pipeline/build-explainer.mjs episodes/pilot-explainer",
    "render:explainer": "node pipeline/build-explainer.mjs episodes/pilot-explainer && node pipeline/render.mjs pilot-explainer",
    "studio": "node scripts/link-public.ts && remotion studio",
    "placeholders": "node scripts/placeholders.ts",
    "tts": "node scripts/tts.ts",
    "voices": "node scripts/voices.ts",
    "analyze": "node scripts/analyze.ts",
    "render": "node scripts/render.ts",
    "frames": "node scripts/render.ts --frames",
    "all": "npm run placeholders && npm run tts && npm run analyze && npm run render",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@remotion/cli": "^4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/google-fonts": "^4.0.539",
    "@remotion/media": "^4.0.539",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
